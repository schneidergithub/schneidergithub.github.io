---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for path in site.data.profile.sitemap_paths %}<url><loc>{{ path | absolute_url | xml_escape }}</loc></url>
{% endfor %}{% assign studies = site.pages | where: 'layout', 'case-study' %}
{% assign essays = site.pages | where: 'layout', 'essay' %}
{% assign entries = studies | concat: essays | sort: 'url' %}
{% for entry in entries %}<url><loc>{{ entry.url | absolute_url | xml_escape }}</loc></url>
{% endfor %}</urlset>
